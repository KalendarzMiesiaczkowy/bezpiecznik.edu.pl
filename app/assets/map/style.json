{
  "version": 8,
  "name": "Bezpiecznik dark",
  "metadata": {
    "bezpiecznik:note": "Placeholders {MBTILES_PATH} and {GLYPHS_DIR} are substituted at runtime; see README.md."
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "mbtiles://{MBTILES_PATH}"
    }
  },
  "glyphs": "file://{GLYPHS_DIR}/{fontstack}/{range}.pbf",

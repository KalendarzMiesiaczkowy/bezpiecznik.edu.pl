      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "wood",
            "grass",
            "farmland"
          ]
        ]
      ],
      "paint": {
        "fill-color": "#8DB89E",
        "fill-opacity": 0.05
      }
    },
    {

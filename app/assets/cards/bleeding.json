  "panels": [
    {
      "type": "steps",
      "title": "Tamowanie krwawienia",
      "read_aloud": true,
      "items": [
        {
          "text": "Na krwawiące miejsce zastosuj silny, bezpośredni ucisk ręką.",
          "source_id": "erc-2025-pierwsza-pomoc-s12-f101"
        },
        {
          "text": "Przyłóż opatrunek standardowy lub hemostatyczny bezpośrednio na krwawiące miejsce.",
          "source_id": "erc-2025-pierwsza-pomoc-s12-f102"
        },
        {
          "text": "Następnie zastosuj silny, bezpośredni ucisk ręką.",
          "source_id": "erc-2025-pierwsza-pomoc-s12-f102"
        },
        {
          "text": "Po opanowaniu krwawienia załóż opatrunek uciskowy.",
          "source_id": "erc-2025-pierwsza-pomoc-s13-f101"
        },
        {
          "text": "Jeśli krwawienie z kończyny zagraża życiu i trwa mimo ucisku ręką, jak najszybciej załóż opaskę uciskową.",
          "source_id": "erc-2025-pierwsza-pomoc-s13-f102"
        },
        {
          "text": "Zanotuj czas założenia opaski uciskowej.",
          "source_id": "erc-2025-pierwsza-pomoc-s13-f103"
        }
      ]
    }
  ],
